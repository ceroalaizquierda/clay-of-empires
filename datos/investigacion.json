 "_claves": {
  "dano.<clase>": "suma al daño (clases: infanteria, tiradores, caballeria)",
  "armadura.<clase>": "suma armadura: resta al daño recibido (mínimo 1 de daño)",
  "vida.<clase>": "multiplica la vida",
  "vel.<clase>": "multiplica la velocidad (también 'aldeanos')",
  "alcance.<clase>": "suma metros de alcance (también 'torres')",
  "vision": "suma metros al rango en que las tropas detectan enemigos",
  "espias": "1 = te avisa cuando un rival sale a atacar (si no, solo cuando ya está cerca)",
  "carga": "suma a lo que carga un aldeano",
  "ritmo.<recurso>": "multiplica la recolección (madera, oro, piedra, comida)",
  "campoComida / campoRitmo / campoCosto / campoSiembra": "modifican las MEJORAS de la cosecha (suma / multiplica / multiplica / multiplica)",
  "obraTiempo": "multiplica el tiempo de construcción",
  "vidaEdificios": "multiplica la vida de los edificios nuevos",
  "poblacion": "suma al tope de población",
  "entrenarTiempo": "multiplica el tiempo de entrenamiento",
  "costoEdificios": "multiplica el costo de los edificios",
  "dano.asedio / vida.asedio": "como las otras clases, para las máquinas de asedio",
  "fuego.<clase>": "1 = los golpes de esa clase a edificios y máquinas los prenden fuego",
  "fuegoRecibido": "multiplica cuánto se queman tus edificios",
  "moral": "suma a la moral máxima de tus tropas (combate.json → moral)",
  "costo.<tipo>": "multiplica el costo de esa tropa",
  "vida.<tipo>": "multiplica la vida de esa tropa (además de la de su clase)",
  "enredo": "multiplica cuánto dura el enredo de las boleadoras",
  "yari": "suma al daño de la infantería sin picas contra el que ya está trabado con picas propias (0,3 = +30%)",
  "rama tradicion": "investigaciones propias de una cultura ('cultura'): se hacen en la base principal",
  "resiembraAuto": "1 = los campos agotados se resiembran solos pagando su costo (se apaga desde el depósito de comida)",
  "dano.<tipo> / armadura.<tipo> / alcance.<tipo>": "suman solo para esa tropa (ej. dano.lancero)",
  "vel.<tipo>": "multiplica la velocidad de esa tropa",
  "rama tropa": "mejora de una tropa puntual ('tropa'): se investiga en el edificio que la entrena y no cuenta para las edades"
